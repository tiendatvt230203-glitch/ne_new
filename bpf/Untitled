/*
 * Gửi 1 gói UDP qua stack kernel (không raw, không hardcode MAC).
 * Build & chạy trên client dưới firewall — FW/ARP tự gắn MAC.
 *
 * Policy 421: UDP encrypt_l2, 192.168.9.2 -> 192.168.180.2
 *   make ne_send_one && ./bin/ne_send_one
 */

#include <arpa/inet.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#define NE_SRC_IP     "192.168.9.2"
#define NE_DST_IP     "192.168.180.2"
#define NE_DST_PORT   12345
#define NE_PAYLOAD    500

/* Payload cố định — dễ tìm trong tcpdump khi NE tắt (cleartext) */
#define NE_MAGIC "NE1UDP_v1_9.2_to_180.2___"

int main(void) {
    char buf[NE_PAYLOAD];
    struct sockaddr_in dst;

    int sock = socket(AF_INET, SOCK_DGRAM, 0);
    if (sock < 0) {
        perror("socket");
        return 1;
    }

    struct sockaddr_in src;
    memset(&src, 0, sizeof(src));
    src.sin_family = AF_INET;
    src.sin_port = htons(0);
    if (inet_pton(AF_INET, NE_SRC_IP, &src.sin_addr) == 1) {
        if (bind(sock, (struct sockaddr *)&src, sizeof(src)) < 0)
            perror("bind (tiếp tục nếu IP không thuộc máy này)");
    }

    memset(&dst, 0, sizeof(dst));
    dst.sin_family = AF_INET;
    dst.sin_port = htons(NE_DST_PORT);
    if (inet_pton(AF_INET, NE_DST_IP, &dst.sin_addr) != 1) {
        fprintf(stderr, "bad dst ip\n");
        close(sock);
        return 1;
    }

    memset(buf, 'X', sizeof(buf));
    memcpy(buf, NE_MAGIC, strlen(NE_MAGIC));

    ssize_t n = sendto(sock, buf, sizeof(buf), 0,
                       (struct sockaddr *)&dst, sizeof(dst));
    close(sock);

    if (n != (ssize_t)sizeof(buf)) {
        perror("sendto");
        return 1;
    }

    fprintf(stderr,
            "OK: 1 UDP %dB %s -> %s:%d (magic at payload start)\n",
            NE_PAYLOAD, NE_SRC_IP, NE_DST_IP, NE_DST_PORT);
    return 0;
}
